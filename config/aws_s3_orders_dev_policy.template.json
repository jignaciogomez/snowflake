{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSnowflakeListDevOrdersPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::amazn-bucket-snowflake",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "nacho/dev/orders/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowSnowflakeReadDevOrdersObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::amazn-bucket-snowflake/nacho/dev/orders/*"
    }
  ]
}
